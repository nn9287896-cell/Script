-- ----- INFINITE STAMINA -----
local function applyInfStamina()
    pcall(function()
        local sys = ReplicatedStorage:FindFirstChild("Systems")
        local chr = sys and sys:FindFirstChild("Character")
        local gm = chr and chr:FindFirstChild("Game")
        local sp = gm and gm:FindFirstChild("Sprinting")
        if not sp then return end
        local m = require(sp)
        if not m then return end
        if not m.DefaultsSet and type(m.Init) == "function" then pcall(function() m.Init() end) end
        m.StaminaLoss = 0
        m.StaminaGain = 999
        m.MaxStamina = 999
        m.StaminaLossDisabled = true
        if m.Stamina and m.Stamina < 999 then m.Stamina = 999 end
        if type(m.StaminaCap) == "number" then m.StaminaCap = 999 end
        if m.__staminaChangedEvent then pcall(function() m.__staminaChangedEvent:Fire() end) end
    end)
end
local function startInfStamina()
    if staminaThread then return end
    staminaThread = task.spawn(function()
        while MISC.InfStamina do
            applyInfStamina()
            task.wait(0.3)
        end
        staminaThread = nil
    end)
end
local function stopInfStamina()
    if staminaThread then pcall(task.cancel, staminaThread); staminaThread = nil end
end
local function setInfStamina(on)
    MISC.InfStamina = on
    if on then applyInfStamina(); startInfStamina() else stopInfStamina() end
end
LocalPlayer.CharacterAdded:Connect(function()
    task.delay(1.5, function()
        if MISC.InfStamina then applyInfStamina(); if not staminaThread then startInfStamina() end end
    end)
end)

-- ----- FOV (FULL FIX) -----
local function applyFOV()
    if not FOV_Active then return end
    local cam = workspace.CurrentCamera
    if cam and math.abs(cam.FieldOfView - FOVValue) > 0.01 then
        pcall(function() cam.FieldOfView = FOVValue end)
    end
end

pcall(function() RunService:UnbindFromRenderStep("NS_FOV_BIND") end)
pcall(function()
    RunService:BindToRenderStep("NS_FOV_BIND", Enum.RenderPriority.Camera.Value + 1000, applyFOV)
end)
RunService.Heartbeat:Connect(applyFOV)
RunService.RenderStepped:Connect(applyFOV)

local function hookCameraFOV(cam)
    if not cam then return end
    pcall(function()
        cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
            if FOV_Active and math.abs(cam.FieldOfView - FOVValue) > 0.01 then
                pcall(function() cam.FieldOfView = FOVValue end)
            end
        end)
    end)
end
hookCameraFOV(workspace.CurrentCamera)
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    hookCameraFOV(workspace.CurrentCamera)
    applyFOV()
end)

local function setFOV(v)
    FOVValue = math.clamp(tonumber(v) or 120, MIN_FOV, MAX_FOV)
    MISC.FOV = FOVValue
    FOV_Active = true
    applyFOV()
end
local function resetFOV() setFOV(120) end
task.defer(applyFOV)

