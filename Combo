local M1_KEYWORDS = { "swing","slash","m1","swipe","stab","lunge","claw","punch","basicattack","lightattack" }
local function isM1Sound(snd)
    if not snd or not snd:IsA("Sound") then return false end
    if _ab_soundIDs[snd.SoundId] then return true end
    local name = snd.Name:lower()
    for _, kw in ipairs(M1_KEYWORDS) do if name:find(kw) then return true end end
    return false
end

local _ab_seen, _ab_hooked, _ab_animHooked = {}, {}, {}
local _ab_active = false
local function _ab_isMe(m) return m and (Players:GetPlayerFromCharacter(m)==LocalPlayer or m.Name==LocalPlayer.Name) end
local function _ab_trigger(model)
    if not _ab_active or not CONFIG.AutoBlock then return end
    if not model or not model.Parent or _ab_isMe(model) then return end
    if _ab_seen[model] and os.clock() < _ab_seen[model] then return end
    _ab_seen[model] = os.clock() + 0.15
    makeHitboxAndCheck(model, function() fireBlock() end)
end
local function _ab_hookSound(snd, model)
    if not snd or not snd:IsA("Sound") or _ab_hooked[snd] then return end
    _ab_hooked[snd] = true
    snd.Played:Connect(function()
        if not _ab_active or not CONFIG.AutoBlock then return end
        if not isM1Sound(snd) then return end
        _ab_trigger(model or snd:FindFirstAncestorOfClass("Model"))
    end)
end
local function _ab_hookAnimator(model)
    if not model or not model:IsA("Model") or _ab_isMe(model) then return end
    local hum = model:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator or _ab_animHooked[animator] then return end
    _ab_animHooked[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId or ""):gsub("%D", "")
        if SLASHER_ANIM_IDS[id] then _ab_trigger(model) end
    end)
end
local function _ab_hookModel(m)
    if not m or not m:IsA("Model") or _ab_isMe(m) then return end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("Sound") then pcall(_ab_hookSound, d, m) end
    end
    pcall(_ab_hookAnimator, m)
    m.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") and not _ab_isMe(m) then
            pcall(_ab_hookSound, d, m)
            if isM1Sound(d) then _ab_trigger(m) end
        elseif d:IsA("Animator") and not _ab_isMe(m) then
            pcall(_ab_hookAnimator, m)
        end
    end)
end
local function _ab_start()
    if _ab_active then return end
    _ab_active = true
    local kf = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
    if not kf then return end
    for _, c in ipairs(kf:GetChildren()) do if c:IsA("Model") then pcall(_ab_hookModel, c) end end
    kf.ChildAdded:Connect(function(c) if c:IsA("Model") then pcall(_ab_hookModel, c) end end)
    log("AutoBlock ON")
end
local function _ab_stop() _ab_active = false; table.clear(_ab_seen); log("AutoBlock OFF") end
local function setAutoBlock(on) CONFIG.AutoBlock = on; if on then _ab_start() else _ab_stop() end end

local function GetClosestKiller(Distance)
    Distance = Distance or 55
    local SK, SD
    for _, v in ipairs(killersFolder:GetChildren()) do
        if Players:GetPlayerFromCharacter(v) and LocalRoot and v:FindFirstChild("HumanoidRootPart")
        and v:FindFirstChildOfClass("Humanoid") and v:FindFirstChildOfClass("Humanoid").Health > 0 then
            local d = (v.HumanoidRootPart.Position - LocalRoot.Position).Magnitude
            if d < Distance then Distance = d; SK = v; SD = d end
        end
    end
    return SK, SD
end

