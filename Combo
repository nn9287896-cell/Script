local function ESP_Drop(m)
    local d = ESP_Cache[m]
    if d then
        pcall(function() if d.hl then d.hl:Destroy() end end)
        pcall(function() if d.bb then d.bb:Destroy() end end)
        ESP_Cache[m] = nil
    end
end

local function ESP_Make(m, c, tf, root)
    if not m or not m.Parent then return nil end
    local cached = ESP_Cache[m]
    if cached then
        if cached.hl then cached.hl.FillColor = c; cached.hl.OutlineColor = c end
        return cached
    end
    local ok, d = pcall(function()
        local hl = Instance.new("Highlight")
        hl.Name = "Sys_ESP_HL"; hl.Adornee = m
        hl.FillColor = c; hl.OutlineColor = c
        hl.FillTransparency = ESP_CFG.OutlineOnly and 1 or 0.7
        hl.OutlineTransparency = ESP_CFG.NoOutline and 1 or 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = m
        local r = root or m:FindFirstChild("HumanoidRootPart")
            or m:FindFirstChild("ItemRoot")
            or m:FindFirstChild("Main")
            or m.PrimaryPart
            or (m:IsA("BasePart") and m)
            or m:FindFirstChildWhichIsA("BasePart", true)
        local bb, lbl = nil, nil
        if r then
            bb = Instance.new("BillboardGui")
            bb.Name = "Sys_ESP_BB"; bb.Adornee = r
            bb.Size = UDim2.new(0, 220, 0, 30); bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true; bb.Parent = r
            lbl = Instance.new("TextLabel", bb)
            lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
            lbl.TextColor3 = c; lbl.TextStrokeTransparency = 0
            lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0); lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamBold
        end
        return {hl = hl, bb = bb, lbl = lbl, textFunc = tf, color = c, root = r}
    end)
    if ok and d then ESP_Cache[m] = d; return d end
    return nil
end

