local function ESP_CheckGear(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    local action = (prompt.ActionText or ""):lower()
    local obj = (prompt.ObjectText or ""):lower()
    return action:find("gear") or obj:find("gear") or action:find("齿轮") or obj:find("齿轮")
end

local function ESP_RegisterGear(prompt)
    if not ESP_CheckGear(prompt) then return end
    local part = prompt.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if part and part:IsA("BasePart") then
        local model = part:FindFirstAncestorOfClass("Model") or part
        ESP_GearCache[model] = {part = part, prompt = prompt}
    end
end

