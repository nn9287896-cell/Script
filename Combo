-- ----- FULLBRIGHT -----
local function applyFullbright()
    if not MISC.Fullbright then return end
    pcall(function()
        Lighting.Brightness = 1.5
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.EnvironmentDiffuseScale = 0.5
        Lighting.EnvironmentSpecularScale = 0.5
        Lighting.FogEnd = 1e100
        Lighting.FogStart = 0
        Lighting.GlobalShadows = false
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("Atmosphere") or e:IsA("BloomEffect")
            or e:IsA("ColorCorrectionEffect") or e:IsA("BlurEffect")
            or e:IsA("SunRaysEffect") or e:IsA("DepthOfFieldEffect") then
                e:Destroy()
            end
        end
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local net = mods and mods:FindFirstChild("Network")
        local rf = net and net:FindFirstChild("RemoteFunction")
        if rf then pcall(function() rf:InvokeServer("GetCurrentLighting") end) end
    end)
end
local function setFullbright(on)
    MISC.Fullbright = on
    if on then applyFullbright() end
end
