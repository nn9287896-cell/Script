local function EnsureDusekkarHook()
    if _DusekkarHookInstalled then return end
    local M = ReplicatedStorage:FindFirstChild("Modules"); if not M then return end
    local N = M:FindFirstChild("Network"); if not N then return end
    local N2 = N:FindFirstChild("Network"); if not N2 then return end
    local RF = N2:FindFirstChild("RemoteFunction"); if not RF then return end
    if not getcallbackvalue or not hookfunction then return end
    _DusekkarHookInstalled = true
    local ok = pcall(function()
        local orig
        orig = hookfunction(getcallbackvalue(RF, "OnClientInvoke"), function(...)
            local args = table.pack(...)
            if args[1] == "GetMousePosition" and _SilentAimDusekkarEnabled and IsDusekkarAnimPlaying() then
                local char = LocalPlayer.Character; local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                local killers = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
                if myRoot and killers then
                    local nearest, nd = nil, math.huge
                    for _, k in ipairs(killers:GetChildren()) do
                        if k:IsA("Model") then
                            local kr = k:FindFirstChild("HumanoidRootPart"); local kh = k:FindFirstChildOfClass("Humanoid")
                            if kr and kh and kh.Health > 0 then
                                local d = (kr.Position - myRoot.Position).Magnitude
                                if d < nd then nd = d; nearest = k end
                            end
                        end
                    end
                    if nearest then
                        local kh = nearest:FindFirstChildOfClass("Humanoid")
                        local kr = nearest:FindFirstChild("HumanoidRootPart")
                        if kr then
                            local pos = kr.Position
                            if kh and kh.MoveDirection.Magnitude > 0.05 then pos = pos + kh.MoveDirection * 0.5 end
                            return pos
                        end
                    end
                end
            end
            return orig(table.unpack(args, 1, args.n))
        end)
    end)
    if not ok then _DusekkarHookInstalled = false end
end

